# BoxOffice Pulse Environment Configuration
# Optional: Connect to a live ClickHouse Cloud or self-hosted cluster
# If left unset, BoxOffice Pulse automatically runs in Embedded Zero-Config Analytical Mode!

VITE_CLICKHOUSE_HOST=https://your-clickhouse-cloud-service.clickhouse.cloud:8443
VITE_CLICKHOUSE_USER=default
VITE_CLICKHOUSE_PASSWORD=your_secure_password
VITE_CLICKHOUSE_DATABASE=default

# Gemini Enterprise / Google AI Studio API Key (Optional for live LLM inference)
VITE_GEMINI_API_KEY=your_gemini_api_key
